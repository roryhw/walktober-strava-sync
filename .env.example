# Your organisation's Walktober site (the address you log in at)
WALKTOBER_BASE=https://<org>.walktober.com
WALKTOBER_EMAIL=you@example.com
WALKTOBER_PASSWORD=change-me

# Telegram bot for the nightly report
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# Echo: where the Strava activities and daily steps come from (read-only)
ECHO_DB=/path/to/echo/data/echo.db
# Optional: ask Echo to refresh Google Health steps before reading
ECHO_URL=http://127.0.0.1:3848
ECHO_ENV_FILE=/path/to/echo/.env

TZ_NAME=America/Los_Angeles
